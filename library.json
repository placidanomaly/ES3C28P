{
  "name": "ES3C28P",
  "version": "2.0.0",
  "description": "Clean ESP32-S3 driver wrapper for the ES3C28P 2.8-inch ILI9341 SPI LCD and FT6336 capacitive touchscreen using TFT_eSPI and LVGL 9.6 without modifying third-party libraries.",
  "keywords": [
    "esp32",
    "esp32-s3",
    "es3c28p",
    "ili9341",
    "ft6336",
    "tft_espi",
    "lvgl",
    "display",
    "touchscreen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/placidanomaly/ES3C28P"
  },
  "authors": [
    {
      "name": "Charles Vaillancourt",
      "email": "charles.vaillancourt@gmail.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/placidanomaly/ES3C28P",
  "dependencies": {
    "bodmer/TFT_eSPI": "^2.5.43",
    "lvgl/lvgl": "^9.6.0"
  },
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "export": {
    "include": [
      "assets/*",
      "assets/**/*",
      "src/*",
      "src/**/*",
      "examples/**/*",
      "examples_platformio/**/*",
      "library.json",
      "library.properties",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/.pio/**",
      "**/.vscode/**",
      "**/*.tar.gz"
    ]
  },
  "examples": [
    {
      "name": "Basic - PlatformIO",
      "base": "examples_platformio/basic",
      "files": [
        "platformio.ini",
        "main.cpp",
        "src/ui/ui_comp_hook.c",
        "src/ui/ui_events.h",
        "src/ui/ui_helpers.c",
        "src/ui/ui_helpers.h",
        "src/ui/ui_Screen1.c",
        "src/ui/ui_Screen1.h",
        "src/ui/ui.c",
        "src/ui/ui.h"
      ]
    },
    {
      "name": "Basic - Arduino",
      "base": "examples/basic",
      "files": [
        "basic.ino",
        "build_opt.h",
        "src/ui/CMakeLists.txt",
        "src/ui/filelist.txt",
        "src/ui/ui_comp_hook.c",
        "src/ui/ui_events.h",
        "src/ui/ui_helpers.c",
        "src/ui/ui_helpers.h",
        "src/ui/ui_Screen1.c",
        "src/ui/ui_Screen1.h",
        "src/ui/ui.c",
        "src/ui/ui.h"
      ]
    }
  ]
}
