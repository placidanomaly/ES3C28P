{
  "name": "ES3C28P",
  "version": "1.1.0",
  "description": "Clean ESP32-S3 driver wrapper for the ES3C28P 2.8-inch ILI9341 SPI LCD and FT6336 capacitive touchscreen using TFT_eSPI and LVGL 9.6 without modifying third-party libraries.",
  "keywords": [
    "esp32",
    "esp32-s3",
    "es3c28p",
    "ili9341",
    "ft6336",
    "tft_espi",
    "lvgl",
    "display",
    "touchscreen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/placidanomaly/ES3C28P"
  },
  "authors": [
    {
      "name": "Charles Vaillancourt",
      "email": "charles.vaillancourt@gmail.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/placidanomaly/ES3C28P/LICENSE",
  "dependencies": {
    "bodmer/TFT_eSPI": "^2.5.43",
    "lvgl/lvgl": "^9.6.0"
  },
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "Basic (PlatformIO)",
      "base": "examples_platformio/basic",
      "files": [
        "platformio.ini",
        "main.cpp"
      ]
    },
    {
      "name": "Basic (Arduino)",
      "base": "examples/basic",
      "files": [
        "basic.ino",
        "build_opt.h"
      ]
    }
  ]
}
